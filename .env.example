# ============================================================
# Q-Guardian Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=Q-Guardian
APP_VERSION=1.1.0
# Application environment (development|testing|production). This is the
# variable the application reads for its environment setting (prefixed
# with APP_); the security helpers also accept the bare ENVIRONMENT var.
APP_ENVIRONMENT=development
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=q_guardian
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000
# Collection persisting the analysis scan history (survives restarts).
MONGODB_HISTORY_COLLECTION=analysis_history
# Collection persisting self-service registered user accounts (survives restarts).
MONGODB_USER_COLLECTION=users
# Collection persisting revoked (logged-out) token identifiers.
MONGODB_TOKEN_BLOCKLIST_COLLECTION=token_blocklist

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# --- API Keys ---
API_KEY_HEADER=X-API-Key

# --- Console UI / API base URL ---
# The console is served by the same application as the API, so the browser
# reaches the API on the same origin by default (works locally and on
# Vercel cloud). Only when the console is served separately from the API
# should you point the UI at a different origin, e.g. load the console with:
#   ?__api=https://your-cloud-api.example.com
# There is no separate backend env var for this; it is a UI-side override.

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- External Services (Future) ---
# QUANTUM_SERVICE_URL=http://localhost:5000
# AI_ANALYSIS_SERVICE_URL=http://localhost:5001
# THREAT_INTEL_SERVICE_URL=http://localhost:5002
